# Data adapter: mock (default, in-memory demo) or postgres (PostgreSQL/Supabase via DATABASE_URL)
KINDLYPAY_DATA_ADAPTER=mock
KINDLYPAY_INTERNAL_API_TOKEN=replace-with-a-long-random-token

# Sign-in. Sessions are signed with this secret (at least 32 characters; required in production).
KINDLYPAY_SESSION_SECRET=replace-with-a-long-random-secret-of-32-plus-characters
# One-click demo workspace on the sign-in page. Set to off for a real deployment.
KINDLYPAY_DEMO_LOGIN=on

# Supabase/PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase: Project Settings → Database → connection string (session pooler, or transaction pooler on 6543).
# TLS: append ?sslmode=verify-full&sslrootcert=/path/to/supabase-ca.crt (or ?sslmode=no-verify to skip CA checks).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kindlypay?sslmode=disable
KINDLYPAY_DB_POOL_SIZE=5

# AI provider. Leave blank to use the deterministic local mock.
OPENAI_API_KEY=
OPENAI_MODEL=

# Public URL used by n8n HTTP Request nodes
KINDLYPAY_BASE_URL=http://host.docker.internal:3000

# Gmail is configured inside n8n. No Gmail secret belongs in this app.
N8N_WEBHOOK_SECRET=replace-with-a-long-random-token
