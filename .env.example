# Data adapter: mock (default, in-memory demo) or postgres (PostgreSQL/Supabase via DATABASE_URL)
KINDLYPAY_DATA_ADAPTER=mock

# Demo button on the sign-in page. With Supabase Auth it signs into this shared account of the seeded
# demo company (create it with npm run db:add-user). Set KINDLYPAY_DEMO_LOGIN=off for a real deployment.
KINDLYPAY_DEMO_LOGIN=on
KINDLYPAY_DEMO_EMAIL=
KINDLYPAY_DEMO_PASSWORD=

# Authentication: supabase (sign-in required) or dev (NO authentication, local only).
# Defaults to supabase when NEXT_PUBLIC_SUPABASE_URL is set, otherwise dev.
KINDLYPAY_AUTH_MODE=
# Dev mode only: the company, role and regions (comma-separated, empty = every region) every request acts as.
KINDLYPAY_DEV_COMPANY_ID=00000000-0000-0000-0000-000000000001
KINDLYPAY_DEV_ROLE=finance_manager
KINDLYPAY_DEV_REGIONS=

# n8n service token, accepted only on the automation endpoints, for exactly one company.
KINDLYPAY_INTERNAL_API_TOKEN=replace-with-a-long-random-token
KINDLYPAY_AUTOMATION_COMPANY_ID=

# Supabase Auth (Project Settings -> API). The service role key is only used by `npm run db:add-user`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase: Project Settings → Database → connection string (session pooler, or transaction pooler on 6543).
# TLS: append ?sslmode=verify-full&sslrootcert=/path/to/supabase-ca.crt (or ?sslmode=no-verify to skip CA checks).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kindlypay?sslmode=disable
KINDLYPAY_DB_POOL_SIZE=5

# AI provider. Leave blank to use the deterministic local mock.
OPENAI_API_KEY=
OPENAI_MODEL=

# Public URL used by n8n HTTP Request nodes
KINDLYPAY_BASE_URL=http://host.docker.internal:3000

# Gmail is configured inside n8n. No Gmail secret belongs in this app.
N8N_WEBHOOK_SECRET=replace-with-a-long-random-token
