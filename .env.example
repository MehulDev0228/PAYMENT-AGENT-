# Data adapter: mock (default, in-memory demo) or postgres (PostgreSQL/Supabase via DATABASE_URL)
AERA_DATA_ADAPTER=mock

# Authentication: supabase (sign-in required) or dev (NO authentication, local only).
# Defaults to supabase when NEXT_PUBLIC_SUPABASE_URL is set, otherwise dev.
AERA_AUTH_MODE=
# Dev mode only: the company and role every request acts as.
AERA_DEV_COMPANY_ID=00000000-0000-0000-0000-000000000001
AERA_DEV_ROLE=finance_manager

# n8n service token, accepted only on the automation endpoints, for exactly one company.
AERA_INTERNAL_API_TOKEN=replace-with-a-long-random-token
AERA_AUTOMATION_COMPANY_ID=

# Supabase Auth (Project Settings -> API). The service role key is only used by `npm run db:add-user`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase: Project Settings → Database → connection string (session pooler, or transaction pooler on 6543).
# TLS: append ?sslmode=verify-full&sslrootcert=/path/to/supabase-ca.crt (or ?sslmode=no-verify to skip CA checks).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aera?sslmode=disable
AERA_DB_POOL_SIZE=5

# AI provider. Leave blank to use the deterministic local mock.
OPENAI_API_KEY=
OPENAI_MODEL=

# Public URL used by n8n HTTP Request nodes
AERA_BASE_URL=http://host.docker.internal:3000

# Gmail is configured inside n8n. No Gmail secret belongs in this app.
N8N_WEBHOOK_SECRET=replace-with-a-long-random-token
